# ── Secrets ─────────────────────────────────────────────────────────────────
.env
*.env.local
*.env.*.local

# ── Copyrighted / generated workspaces (never commit translation data) ─────
raw/
work/
output/*
!output/.gitkeep
logs/*
!logs/.gitkeep
cache/*
!cache/.gitkeep
.mcp_state/

# ── Local agent state (AGENTS.md, CLAUDE.md, harness/ and .codex/config.toml
#    are shipped; per-user settings and run output are not) ─────────────────
.claude/
CLAUDE.local.md
.claude.json
.codex/*
!.codex/config.toml
.harness/

# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
venv/
.pytest_cache/
*.log

# ── Node / TypeScript ───────────────────────────────────────────────────────
node_modules/
*.tsbuildinfo
dist-ts/

# ── IDE / OS ────────────────────────────────────────────────────────────────
.vscode/settings.json
.vscode/*.code-workspace
.idea/
.DS_Store
Thumbs.db
